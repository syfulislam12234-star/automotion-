# =================================================================
# Groq Telegram Bot Builder & Universal VPS Management Environment
# =================================================================

# Server-Side Gemini API Key (managed via AI Studio Secrets)
GEMINI_API_KEY=

# App Hosting URL (injected by Cloud Run runtime)
APP_URL=

# -----------------------------------------------------------------
# 1. Chat Platform Tokens (Messaging Gateways)
# -----------------------------------------------------------------
# Required for Telegram Bot in Production:
TELEGRAM_BOT_TOKEN=
# Update mode: "polling" (recommended default on Railway) or "webhook"
RUN_MODE=polling
# Required only if RUN_MODE=webhook:
PUBLIC_BASE_URL=https://your-service.up.railway.app
WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_SECRET_TOKEN=

# -----------------------------------------------------------------
# 2. Multi-Provider AI Keys (Zero-Downtime Cascade Pool)
# -----------------------------------------------------------------
GROQ_API_KEY=
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
KEY_COOLDOWN_SECONDS=60

CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama3.3-70b

OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-r1:free

SAMBANOVA_API_KEY=
SAMBANOVA_MODEL=Meta-Llama-3.3-70B-Instruct

MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

TOGETHER_API_KEY=
TOGETHER_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo-Free

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

GITHUB_TOKEN=
GITHUB_MODEL=gpt-4o-mini

HUGGINGFACE_API_TOKEN=
HUGGINGFACE_MODEL=meta-llama/Llama-3.2-3B-Instruct

COHERE_API_KEY=
COHERE_MODEL=command-r-plus

NVIDIA_NIM_API_KEY=
NVIDIA_NIM_MODEL=meta/llama-3.3-70b-instruct

DEEPINFRA_API_KEY=
DEEPINFRA_MODEL=meta-llama/Meta-Llama-3-70B-Instruct

CHUTES_API_KEY=
CHUTES_MODEL=deepseek-ai/DeepSeek-V3

VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3-lite

REPLICATE_API_TOKEN=
REPLICATE_MODEL=meta/meta-llama-3-70b-instruct

CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_MODEL=@cf/meta/llama-3.3-70b-instruct

POLLINATIONS_MODEL=flux
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# -----------------------------------------------------------------
# 3. Dual Admin Error & Failover Alerting
# -----------------------------------------------------------------
ADMIN_TELEGRAM_ID=
DISCORD_ADMIN_WEBHOOK_URL=

# -----------------------------------------------------------------
# 4. YouTube OAuth2 & Creator Automation Suite
# -----------------------------------------------------------------
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_CHANNEL_ID=
YOUTUBE_CLIENT_SECRET_FILE=client_secret.json
YOUTUBE_TOKEN_FILE=token.json

# -----------------------------------------------------------------
# 5. VPS Server Management & n8n 24/7 Automation Bridge
# -----------------------------------------------------------------
VPS_AUTH_TOKEN=
VPS_API_BASE_URL=http://127.0.0.1:8080
N8N_WEBHOOK_URL=
N8N_ENABLED=true

# -----------------------------------------------------------------
# 6. Cloud & Runtime Hyperparameters
# -----------------------------------------------------------------
PORT=8080
SERVER_PORT=8080
RUN_MODE=polling
MAX_MEMORY_TURNS=10
MEMORY_TTL_MINUTES=30
TEMPERATURE=0.7
MAX_OUTPUT_TOKENS=2048
SYSTEM_PROMPT="You are a helpful, ultra-fast AI assistant powered by a 20-tier multi-provider fallback engine."
ADMIN_PASSWORD=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
